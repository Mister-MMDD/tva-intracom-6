diff --git a/tva_intracom/audit_classify.py b/tva_intracom/audit_classify.py
new file mode 100644
index 0000000..bd65d52
--- /dev/null
+++ b/tva_intracom/audit_classify.py
@@ -0,0 +1,28 @@
+"""Règles de classement partagées des écarts Amazon vs moteur (UI Audit + export Excel).
+
+Source unique pour éviter que l'onglet Audit et le rapport Excel divergent.
+"""
+from __future__ import annotations
+
+from tva_intracom.rates import is_eu
+
+
+def is_non_eu_flow(stock_country: str, buyer_country: str) -> bool:
+    """Flux hors Europe : acheteur hors UE (Royaume-Uni inclus) ou livraison vers GB.
+
+    Le critère est la DESTINATION, pas le stock : une vente depuis un stock hors UE
+    vers un acheteur UE (ex. US→FI, DEEMED_SUPPLIER) est TAXÉE (Amazon collecte) ;
+    son écart éventuel est un écart de taux, pas un flux hors Europe.
+    Le moteur exonère (export) quand l'acheteur est hors UE, alors qu'Amazon
+    collecte une TVA locale : ce n'est ni un écart de taux ni un risque VIES.
+    """
+    return buyer_country == "GB" or not is_eu(buyer_country)
+
+
+def is_vies_risk_gap(in_vies_affected: bool, tva_amazon: float) -> bool:
+    """Risque VIES réel = Amazon a exonéré (TVA Amazon == 0) un acheteur dont le n° est invalide.
+
+    Si Amazon a TAXÉ (VIES invalide bien détecté), le résidu moteur/Amazon n'est
+    qu'un écart de taux (ex. 20 % FR vs 21/22 % destination) : pas un risque VIES.
+    """
+    return in_vies_affected and tva_amazon == 0
